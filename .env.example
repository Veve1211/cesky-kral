# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Optional: Ko-fi page for the "Hoď kronikáři groš" button (https://ko-fi.com/…).
# Read at BUILD time – after changing it, deploy again. Leave unset to hide the button.
# NEXT_PUBLIC_KOFI_URL="https://ko-fi.com/your-page"

# Optional, production only. Use the tracker URL and Website ID shown in your Umami settings.
# Set both for the Railway build, then deploy again.
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=

# Optional, production only. Deploy with the same valid IndexNow key at build and runtime.
# INDEXNOW_KEY=
