// Data model for Český král.
// PostgreSQL on Railway (one database per environment).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model King {
  id                Int        @id @default(autoincrement())
  name              String
  slug              String     @unique
  reignFrom         Int? // null for legendary figures
  reignTo           Int?
  /// kníže / kněžna / král / královna (CHECK constraint in migration)
  title             String     @default("král")
  isLegend          Boolean    @default(false)
  dynasty           String
  shortBio          String
  imageUrl          String?
  order             Int        @unique
  /// Chronicle shown after the king is collected (empty = no chronicle yet)
  chronicleIntro    String     @default("")
  chronicleFacts    String[]   @default([])
  /// [{ "label": string, "url": "https://..." }]
  chronicleSources  Json       @default("[]")
  /// [{ "heading": string, "text": string }] – shown instead of the intro when not empty
  chronicleSections Json       @default("[]")
  questions         Question[]

  @@index([dynasty])
}

model Question {
  id          Int      @id @default(autoincrement())
  kingId      Int
  king        King     @relation(fields: [kingId], references: [id], onDelete: Cascade)
  text        String
  explanation String
  sourceUrl   String?
  /// 1 = easy, 2 = medium, 3 = hard (CHECK constraint in migration)
  difficulty  Int      @default(1)
  answers     Answer[]

  @@index([kingId, difficulty])
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}

/// Anonymous player – no account, no personal data. The browser keeps a
/// random token; the server stores only its SHA-256 hash.
model Player {
  id            Int            @id @default(autoincrement())
  tokenHash     String         @unique
  /// Shown in leaderboards (3–16 chars, filtered); null = not in leaderboards
  nickname      String?
  /// Normalized nickname (lowercase, no diacritics/spaces) – unique
  nicknameKey   String?        @unique
  /// Own coat of arms – only its parameters (validated), shown next to the nickname
  crest         Json?
  createdAt     DateTime       @default(now())
  dailyAttempts DailyAttempt[]
  transferCodes TransferCode[]
  gameSessions  GameSession[]
}

/// One "Denní výzva" attempt per player and day. Scored only by the server.
model DailyAttempt {
  id         Int       @id @default(autoincrement())
  playerId   Int
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Prague calendar date, YYYY-MM-DD
  date       String
  /// Right/wrong per answered question, in order
  marks      Boolean[] @default([])
  answered   Int       @default(0)
  score      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@unique([playerId, date])
  @@index([date, score, durationMs])
}

/// Short-lived, single-use code to move progress to another device.
model TransferCode {
  id        Int       @id @default(autoincrement())
  /// SHA-256 of the code – the code itself is never stored
  codeHash  String    @unique
  playerId  Int
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Snapshot of the browser progress (validated, size-limited)
  payload   Json
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// One game of Rychlovka, "Kdo vládl dřív?" or "Řeka času", scored only by
/// the server. `state` holds what the server asked (question ids / rulers).
model GameSession {
  id         Int       @id @default(autoincrement())
  /// Random public id the browser uses (never the numeric id)
  publicId   String    @unique
  playerId   Int
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// quick / who-first / timeline (CHECK constraint in migration)
  mode       String
  state      Json
  answered   Int       @default(0)
  score      Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  @@index([mode, finishedAt])
  @@index([playerId, mode])
}
