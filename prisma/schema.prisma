// Data model for Český král.
// Database is not connected yet (Railway PostgreSQL comes in the next step).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model King {
  id                Int        @id @default(autoincrement())
  name              String
  slug              String     @unique
  reignFrom         Int? // null for legendary figures
  reignTo           Int?
  /// kníže / kněžna / král / královna (CHECK constraint in migration)
  title             String     @default("král")
  isLegend          Boolean    @default(false)
  dynasty           String
  shortBio          String
  imageUrl          String?
  order             Int        @unique
  /// Chronicle shown after the king is collected (empty = no chronicle yet)
  chronicleIntro    String     @default("")
  chronicleFacts    String[]   @default([])
  /// [{ "label": string, "url": "https://..." }]
  chronicleSources  Json       @default("[]")
  /// [{ "heading": string, "text": string }] – shown instead of the intro when not empty
  chronicleSections Json       @default("[]")
  questions         Question[]

  @@index([dynasty])
}

model Question {
  id          Int      @id @default(autoincrement())
  kingId      Int
  king        King     @relation(fields: [kingId], references: [id], onDelete: Cascade)
  text        String
  explanation String
  sourceUrl   String?
  /// 1 = easy, 2 = medium, 3 = hard (CHECK constraint in migration)
  difficulty  Int      @default(1)
  answers     Answer[]

  @@index([kingId, difficulty])
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  @@index([questionId])
}
